DEFINITION MODULE Sockets;

FROM SYSTEM IMPORT ADDRESS;

EXPORT QUALIFIED 
    SocketHandle, NetError, ProtocolType, FamilyType, IpAddr,
    
    (* Protocol Levels *)
    SOL_SOCKET, IPPROTO_IP, IPPROTO_TCP, IPPROTO_IPV6,
    
    (* SOL_SOCKET Options *)
    SO_DEBUG, SO_REUSEADDR, SO_TYPE, SO_ERROR, SO_DONTROUTE,
    SO_BROADCAST, SO_SNDBUF, SO_RCVBUF, SO_KEEPALIVE, SO_OOBINLINE,
    SO_NO_CHECK, SO_PRIORITY, SO_LINGER, SO_BSDCOMPAT, SO_REUSEPORT,
    SO_PASSCRED, SO_PEERCRED, SO_RCVLOWAT, SO_SNDLOWAT, SO_RCVTIMEO,
    SO_SNDTIMEO, SO_ACCEPTCONN, SO_PEERSEC, SO_PASSSEC, SO_MARK,
    SO_TIMESTAMP, SO_RXQ_OVFL, SO_WIFI_STATUS, SO_PEEK_OFF, SO_NOFCS,
    SO_LOCK_FILTER, SO_SELECT_ERR_QUEUE, SO_BUSY_POLL, SO_MAX_PACING_RATE,
    SO_BPF_EXTENSIONS, SO_INCOMING_CPU, SO_ATTACH_BPF, SO_DETACH_BPF,
    
    (* IPPROTO_IP (IPv4) Options *)
    IP_TOS, IP_TTL, IP_HDRINCL, IP_OPTIONS, IP_ROUTER_ALERT,
    IP_RECVOPTS, IP_RETOPTS, IP_PKTINFO, IP_PKTOPTIONS, IP_MTU_DISCOVER,
    IP_RECVERR, IP_RECVTTL, IP_RECVTOS, IP_MTU, IP_FREEBIND,
    IP_IPSEC_POLICY, IP_XFRM_POLICY, IP_PASSSEC, IP_MULTICAST_IF,
    IP_MULTICAST_TTL, IP_MULTICAST_LOOP, IP_ADD_MEMBERSHIP,
    IP_DROP_MEMBERSHIP, IP_UNBLOCK_SOURCE, IP_BLOCK_SOURCE,
    IP_ADD_SOURCE_MEMBERSHIP, IP_DROP_SOURCE_MEMBERSHIP,
    
    (* IPPROTO_IPV6 Options *)
    IPV6_ADDRFORM, IPV6_2292PKTINFO, IPV6_2292HOPOPTS, IPV6_2292DSTOPTS,
    IPV6_2292RTHDR, IPV6_2292PKTOPTIONS, IPV6_CHECKSUM, IPV6_2292HOPLIMIT,
    IPV6_NEXTHOP, IPV6_AUTHHDR, IPV6_UNICAST_HOPS, IPV6_MULTICAST_IF,
    IPV6_MULTICAST_HOPS, IPV6_MULTICAST_LOOP, IPV6_JOIN_GROUP,
    IPV6_LEAVE_GROUP, IPV6_ROUTER_ALERT, IPV6_MTU_DISCOVER, IPV6_MTU,
    IPV6_RECVERR, IPV6_V6ONLY, IPV6_JOIN_ANYCAST, IPV6_LEAVE_ANYCAST,
    
    (* IPPROTO_TCP Options *)
    TCP_NODELAY, TCP_MAXSEG, TCP_CORK, TCP_KEEPIDLE, TCP_KEEPINTVL,
    TCP_KEEPCNT, TCP_SYNCNT, TCP_LINGER2, TCP_DEFER_ACCEPT, TCP_WINDOW_CLAMP,
    TCP_INFO, TCP_QUICKACK, TCP_CONGESTION, TCP_MD5SIG, TCP_THIN_LINEAR_TIMEOUTS,
    TCP_THIN_DUPACK, TCP_USER_TIMEOUT, TCP_REPAIR, TCP_REPAIR_QUEUE,
    TCP_QUEUE_SEQ, TCP_REPAIR_OPTIONS, TCP_FASTOPEN, TCP_TIMESTAMP,

    (* Core API Engine *)
    CreateSocket, BindSocket, ListenForConnections, AcceptConnection,
    ConnectToServer, SendData, RecvData, CloseSocket,
    GetSystemErrorMessage, TextToIp, IpToText,
    SetSocketOption, GetSocketOption;

TYPE
  SocketHandle = INTEGER;

  NetError = (
    Success,
    SocketCreationError,
    BindError,
    ListenError,
    AcceptError,
    ConnectError,
    SendError,
    RecvError,
    ClosedByPeer,
    InvalidAddressFormat,
    SocketOptionError
  );

  ProtocolType = (TCP, UDP);
  FamilyType   = (IPv4, IPv6);

  IpAddr = RECORD
    CASE family: FamilyType OF
      IPv4: v4Addr: CARDINAL; |
      IPv6: v6Addr: ARRAY [0..15] OF SHORTCARD;
    END;
  END;

CONST
  (* ==========================================================================
     PROTOCOL CONFIGURATION LEVELS
     ========================================================================== *)
  SOL_SOCKET    = 1;
  IPPROTO_IP    = 0;
  IPPROTO_TCP   = 6;
  IPPROTO_IPV6  = 41;

  (* ==========================================================================
     SOL_SOCKET CORE LAYER CONSTANTS
     ========================================================================== *)
  SO_DEBUG            = 1;
  SO_REUSEADDR        = 2;
  SO_TYPE             = 3;
  SO_ERROR            = 4;
  SO_DONTROUTE        = 5;
  SO_BROADCAST        = 6;
  SO_SNDBUF           = 7;
  SO_RCVBUF           = 8;
  SO_KEEPALIVE        = 9;
  SO_OOBINLINE        = 10;
  SO_NO_CHECK         = 11;
  SO_PRIORITY         = 12;
  SO_LINGER           = 13;
  SO_BSDCOMPAT        = 14;
  SO_REUSEPORT        = 15;
  SO_PASSCRED         = 16;
  SO_PEERCRED         = 17;
  SO_RCVLOWAT         = 18;
  SO_SNDLOWAT         = 19;
  SO_RCVTIMEO         = 20;
  SO_SNDTIMEO         = 21;
  SO_TIMESTAMP        = 29;
  SO_ACCEPTCONN       = 30;
  SO_PEERSEC          = 31;
  SO_PASSSEC          = 34;
  SO_MARK             = 36;
  SO_RXQ_OVFL         = 40;
  SO_WIFI_STATUS      = 41;
  SO_PEEK_OFF         = 42;
  SO_NOFCS            = 43;
  SO_LOCK_FILTER      = 44;
  SO_SELECT_ERR_QUEUE = 45;
  SO_BUSY_POLL        = 46;
  SO_MAX_PACING_RATE  = 47;
  SO_BPF_EXTENSIONS   = 48;
  SO_INCOMING_CPU     = 49;
  SO_ATTACH_BPF       = 50;
  SO_DETACH_BPF       = SO_ATTACH_BPF;

  (* ==========================================================================
     IPPROTO_IP (IPv4) LAYER CONSTANTS
     ========================================================================== *)
  IP_TOS                   = 1;
  IP_TTL                   = 2;
  IP_HDRINCL               = 3;
  IP_OPTIONS               = 4;
  IP_ROUTER_ALERT          = 5;
  IP_RECVOPTS              = 6;
  IP_RETOPTS               = 7;
  IP_PKTINFO               = 8;
  IP_PKTOPTIONS            = 9;
  IP_MTU_DISCOVER          = 10;
  IP_RECVERR               = 11;
  IP_RECVTTL               = 12;
  IP_RECVTOS               = 13;
  IP_MTU                   = 14;
  IP_FREEBIND              = 15;
  IP_IPSEC_POLICY          = 16;
  IP_XFRM_POLICY           = 17;
  IP_PASSSEC               = 18;
  IP_MULTICAST_IF          = 32;
  IP_MULTICAST_TTL         = 33;
  IP_MULTICAST_LOOP        = 34;
  IP_ADD_MEMBERSHIP        = 35;
  IP_DROP_MEMBERSHIP       = 36;
  IP_UNBLOCK_SOURCE        = 37;
  IP_BLOCK_SOURCE          = 38;
  IP_ADD_SOURCE_MEMBERSHIP = 39;
  IP_DROP_SOURCE_MEMBERSHIP= 40;

  (* ==========================================================================
     IPPROTO_IPV6 LAYER CONSTANTS
     ========================================================================== *)
  IPV6_ADDRFORM        = 1;
  IPV6_2292PKTINFO     = 2;
  IPV6_2292HOPOPTS     = 3;
  IPV6_2292DSTOPTS     = 4;
  IPV6_2292RTHDR       = 5;
  IPV6_2292PKTOPTIONS  = 6;
  IPV6_CHECKSUM        = 7;
  IPV6_2292HOPLIMIT    = 8;
  IPV6_NEXTHOP         = 9;
  IPV6_AUTHHDR         = 10;
  IPV6_UNICAST_HOPS    = 16;
  IPV6_MULTICAST_IF    = 17;
  IPV6_MULTICAST_HOPS  = 18;
  IPV6_MULTICAST_LOOP  = 19;
  IPV6_JOIN_GROUP      = 20;
  IPV6_LEAVE_GROUP     = 21;
  IPV6_ROUTER_ALERT    = 22;
  IPV6_MTU_DISCOVER    = 23;
  IPV6_MTU             = 24;
  IPV6_RECVERR         = 25;
  IPV6_V6ONLY          = 26;
  IPV6_JOIN_ANYCAST    = 27;
  IPV6_LEAVE_ANYCAST   = 28;

  (* ==========================================================================
     IPPROTO_TCP LAYER CONSTANTS
     ========================================================================== *)
  TCP_NODELAY              = 1;
  TCP_MAXSEG               = 2;
  TCP_CORK                 = 3;
  TCP_KEEPIDLE             = 4;
  TCP_KEEPINTVL            = 5;
  TCP_KEEPCNT              = 6;
  TCP_SYNCNT               = 7;
  TCP_LINGER2              = 8;
  TCP_DEFER_ACCEPT         = 9;
  TCP_WINDOW_CLAMP         = 10;
  TCP_INFO                 = 11;
  TCP_QUICKACK             = 12;
  TCP_CONGESTION           = 13;
  TCP_MD5SIG               = 14;
  TCP_THIN_LINEAR_TIMEOUTS = 16;
  TCP_THIN_DUPACK          = 17;
  TCP_USER_TIMEOUT         = 18;
  TCP_REPAIR               = 19;
  TCP_REPAIR_QUEUE         = 20;
  TCP_QUEUE_SEQ            = 21;
  TCP_REPAIR_OPTIONS       = 22;
  TCP_FASTOPEN             = 23;
  TCP_TIMESTAMP            = 24;

(* Engine API Controls *)
PROCEDURE CreateSocket (family: FamilyType; proto: ProtocolType; VAR sock: SocketHandle): NetError;
PROCEDURE BindSocket (sock: SocketHandle; family: FamilyType; port: CARDINAL): NetError;
PROCEDURE ListenForConnections (sock: SocketHandle; backlog: INTEGER): NetError;
PROCEDURE AcceptConnection (serverSock: SocketHandle; VAR clientSock: SocketHandle): NetError;
PROCEDURE ConnectToServer (sock: SocketHandle; family: FamilyType; ipAddress: ARRAY OF CHAR; port: CARDINAL): NetError;
PROCEDURE SendData (sock: SocketHandle; buffer: ADDRESS; bytesToSend: CARDINAL; VAR bytesSent: CARDINAL): NetError;
PROCEDURE RecvData (sock: SocketHandle; buffer: ADDRESS; maxBytes: CARDINAL; VAR bytesReceived: CARDINAL): NetError;
PROCEDURE CloseSocket (VAR sock: SocketHandle);
PROCEDURE GetSystemErrorMessage (VAR dest: ARRAY OF CHAR);
PROCEDURE TextToIp (family: FamilyType; text: ARRAY OF CHAR; VAR ip: IpAddr): NetError;
PROCEDURE IpToText (ip: IpAddr; VAR dest: ARRAY OF CHAR): NetError;
PROCEDURE SetSocketOption (sock: SocketHandle; level: INTEGER; optionName: INTEGER; optionValue: ADDRESS; optionLen: CARDINAL): NetError;
PROCEDURE GetSocketOption (sock: SocketHandle; level: INTEGER; optionName: INTEGER; optionValue: ADDRESS; VAR optionLen: CARDINAL): NetError;

END Sockets.
